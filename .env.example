# Copy to .env.local and fill in. Never commit real values.

# Neon (region AWS Singapore ap-southeast-1)
# Pooled connection string (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (no "-pooler") — used by migrations and backups
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The public URL of the app (http://localhost:3000 in dev)
BETTER_AUTH_URL="http://localhost:3000"

# Photo storage — Neon Object Storage (default). `neon deploy` writes these AWS_*
# values into .env.local for you. On Vercel use the STORAGE_* names instead,
# because Vercel reserves AWS_* names.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
# STORAGE_ENDPOINT=""
# STORAGE_REGION=""
STORAGE_BUCKET="baki-photos"

# Optional: use Cloudflare R2 instead (setting R2_ACCOUNT_ID switches to R2)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="baki-photos"

# Seed only (npm run seed) — your single owner account
OWNER_EMAIL=""
OWNER_PASSWORD=""
OWNER_NAME="Owner"
