    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run i18n:check",
    "storage:setup": "tsx --conditions=react-server scripts/storage-setup.ts",
    "neon": "neonctl",
    "backup": "tsx scripts/backup.ts"
  },
